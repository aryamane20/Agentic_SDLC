{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PM Digital Twin Output Schema",
  "description": "JSON Schema for PM Digital Twin project report output",
  "type": "object",
  "required": [
    "report_metadata",
    "project_understanding",
    "assumption_log",
    "project_plan",
    "risk_register",
    "staffing_plan",
    "pm_confidence_score"
  ],
  "properties": {
    "report_metadata": {
      "type": "object",
      "properties": {
        "report_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "model_version": { "type": "string" },
        "input_summary": { "type": "string" }
      }
    },
    "project_understanding": {
      "type": "object",
      "properties": {
        "primary_goal": { "type": "string" },
        "beneficiary": { "type": "string" },
        "trigger": { "type": "string" },
        "success_definition": { "type": "string" },
        "project_type": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
        "classification_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    },
    "assumption_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "what": { "type": "string" },
          "why": { "type": "string" },
          "pmi_basis": { "type": "string" },
          "risk_if_wrong": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "consequence": { "type": "string" }
        }
      }
    },
    "project_plan": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "phase_id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "duration_percent": { "type": "number" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "task_id": { "type": "string" },
                    "name": { "type": "string" },
                    "effort_hours": { "type": "number" },
                    "owner_role": { "type": "string" },
                    "dependencies": { "type": "array", "items": { "type": "string" } },
                    "risk_flag": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "risk_register": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "risk_id": { "type": "string" },
          "description": { "type": "string" },
          "probability": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "impact": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "score": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "staffing_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "allocation_percent": { "type": "number", "maximum": 80 },
          "hours": { "type": "number" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "pm_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}

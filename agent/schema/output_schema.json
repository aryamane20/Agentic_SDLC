{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PM Digital Twin Output Schema",
  "description": "Schema for validating the structured JSON output of the PM Digital Twin agent",
  "type": "object",
  "required": [
    "report_metadata",
    "project_understanding",
    "assumption_log",
    "project_plan",
    "risk_register",
    "staffing_plan",
    "open_questions",
    "pm_confidence_score"
  ],
  "properties": {
    "report_metadata": {
      "type": "object",
      "required": ["generated_at", "input_quality", "pm_confidence_score", "project_type", "sdlc_approach"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "input_quality": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "pm_confidence_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "project_type": { "type": "string", "enum": ["TYPE_A", "TYPE_B", "TYPE_C", "TYPE_D", "TYPE_E", "TYPE_F"] },
        "classification_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "sdlc_approach": { "type": "string", "enum": ["Predictive", "Adaptive", "Hybrid"] },
        "sdlc_rationale": { "type": "string", "minLength": 10 }
      }
    },

    "project_understanding": {
      "type": "object",
      "required": ["primary_goal", "beneficiary", "trigger", "success_definition"],
      "properties": {
        "primary_goal": { "type": "string", "minLength": 10 },
        "beneficiary": { "type": "string" },
        "trigger": { "type": "string" },
        "success_definition": { "type": "string" },
        "supporting_quotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "assumption_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "why", "pmi_basis", "risk_if_wrong", "consequence"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]+$" },
          "what": { "type": "string", "minLength": 10 },
          "why": { "type": "string", "minLength": 10 },
          "pmi_basis": { "type": "string", "minLength": 5 },
          "risk_if_wrong": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "consequence": { "type": "string", "minLength": 10 },
          "source": {
            "type": "string",
            "enum": ["hard_constraint", "soft_constraint", "nfr", "scope", "other"],
            "description": "Which category of gap generated this assumption. nfr = non-functional requirement gap."
          }
        }
      }
    },

    "project_plan": {
      "type": "object",
      "required": ["total_duration_weeks", "buffer_applied_percent", "phases", "critical_path_summary"],
      "properties": {
        "total_duration_weeks": { "type": "number", "minimum": 1 },
        "buffer_applied_percent": { "type": "number", "minimum": 0 },
        "critical_path_summary": {
          "type": "object",
          "required": ["sequence", "total_duration_days", "zero_slack_tasks", "staffing_implication"],
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^T[0-9]+$" }
            },
            "total_duration_days": { "type": "number", "minimum": 1 },
            "zero_slack_tasks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^T[0-9]+$" }
            },
            "highest_slack_tasks": {
              "type": "array",
              "items": { "type": "string", "pattern": "^T[0-9]+$" }
            },
            "staffing_implication": { "type": "string", "minLength": 10 }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["phase_number", "name", "duration_weeks", "percentage_of_total", "milestones", "tasks"],
            "properties": {
              "phase_number": { "type": "integer", "minimum": 1, "maximum": 5 },
              "name": { "type": "string" },
              "duration_weeks": { "type": "number", "minimum": 0.5 },
              "percentage_of_total": { "type": "number", "minimum": 5, "maximum": 50 },
              "milestones": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              },
              "tasks": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "required": ["id", "name", "phase", "effort_hours", "owner_role", "dependencies", "risk_flag", "critical_path", "slack_days", "definition_of_done"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^T[0-9]+$" },
                    "name": { "type": "string", "minLength": 5 },
                    "phase": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "effort_hours": { "type": "number", "minimum": 1, "maximum": 40 },
                    "owner_role": { "type": "string" },
                    "dependencies": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "risk_flag": { "type": "boolean" },
                    "critical_path": { "type": "boolean" },
                    "slack_days": { "type": "integer", "minimum": 0 },
                    "definition_of_done": { "type": "string", "minLength": 10 }
                  }
                }
              }
            }
          }
        }
      }
    },

    "risk_register": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "probability", "impact", "score", "trigger", "mitigation", "contingency"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "category": { "type": "string", "enum": ["Schedule", "Resource", "Technical", "Scope", "External", "Compliance"] },
          "description": { "type": "string", "minLength": 20 },
          "probability": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "impact": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "score": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "trigger": { "type": "string", "minLength": 10 },
          "mitigation": { "type": "string", "minLength": 10 },
          "contingency": { "type": "string", "minLength": 10 }
        }
      }
    },

    "staffing_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "phase_involvement", "total_hours", "allocation_percent", "skills_required", "critical_path"],
        "properties": {
          "role": { "type": "string" },
          "phase_involvement": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "total_hours": { "type": "number", "minimum": 1 },
          "allocation_percent": { "type": "number", "minimum": 1, "maximum": 80 },
          "skills_required": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "critical_path": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },

    "open_questions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["priority", "question", "urgency", "impact_if_unanswered"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "question": { "type": "string", "minLength": 10 },
          "urgency": { "type": "string", "enum": ["Before planning", "Before build", "Before launch"] },
          "impact_if_unanswered": { "type": "string", "minLength": 10 }
        }
      }
    },

    "pm_confidence_score": {
      "type": "object",
      "required": ["score", "deductions", "interpretation"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["amount", "reason"],
            "properties": {
              "amount": { "type": "number" },
              "reason": { "type": "string" }
            }
          }
        },
        "interpretation": { "type": "string", "minLength": 10 }
      }
    }
  }
}
